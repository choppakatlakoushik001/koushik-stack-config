#!/usr/bin/env bash
# leakscan pre-push gate: scan every commit range about to leave this machine.
zero=0000000000000000000000000000000000000000; empty=4b825dc642cb6eb9a060e54bf8d69288fbee4904
rc=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then base=$(git merge-base "$lsha" "$2/HEAD" 2>/dev/null || echo $empty); else base=$rsha; fi
  python3 "$HOME/local-llm/leakscan/leakscan.py" diff "$(git rev-parse --git-dir)" "$base" "$lsha" || rc=1
done
[ $rc -eq 0 ] || echo "leak-watch: push blocked by leakscan; review the findings above" >&2
exit $rc
